{
  "area": "acme",
  "title": "Services → ACME Client (plugin os-acme-client)",
  "mcp": false,
  "embed": "acmeManual",
  "settings": [
    {
      "resource": "acme_settings",
      "go_name": "AcmeSettings",
      "plural": "Settings",
      "id": "acmeclient",
      "description": "Global ACME client settings (Services → ACME Client → Settings).",
      "model": "plugins/security/acme-client/AcmeClient/AcmeClient.xml",
      "node": "settings",
      "get": "acmeclient/settings/get",
      "set": "acmeclient/settings/set",
      "path": ["acmeclient", "settings"],
      "reconfigure": "acmeclient/service/reconfigure",
      "disable": "enabled",
      "fields": {
        "enabled": {"default": "1", "description": "Run the ACME client. Certificates are only issued when enabled."},
        "autoRenewal": {"attr": "auto_renewal", "description": "Renew certificates automatically (cron job)."},
        "UpdateCron": {"computed": true, "tf": false, "description": "Cron job the plugin manages."},
        "environment": {"description": "`stg` uses the CAs' staging endpoints for every account."},
        "challengePort": {"attr": "challenge_port", "type": "int", "description": "Local port for HTTP-01 challenges."},
        "TLSchallengePort": {"attr": "tls_challenge_port", "go_name": "TLSChallengePort", "type": "int", "description": "Local port for TLS-ALPN-01 challenges."},
        "restartTimeout": {"attr": "restart_timeout", "description": "Seconds to wait for automations."},
        "haproxyIntegration": {"attr": "haproxy_integration", "go_name": "HAProxyIntegration", "description": "Let the plugin manage HAProxy rules for HTTP-01 challenges."},
        "haproxyAclRef": {"computed": true, "tf": false},
        "haproxyActionRef": {"computed": true, "tf": false},
        "haproxyServerRef": {"computed": true, "tf": false},
        "haproxyBackendRef": {"computed": true, "tf": false},
        "logLevel": {"attr": "log_level"},
        "showIntro": {"skip": true}
      },
      "update": {"restartTimeout": "300"}
    }
  ],
  "items": [
    {
      "resource": "acme_account",
      "go_name": "AcmeAccount",
      "plural": "Accounts",
      "description": "An account with an ACME certificate authority (Services → ACME Client → Accounts). OPNsense registers it on first use; the MCP tool acme_account_register does it immediately.",
      "model": "plugins/security/acme-client/AcmeClient/AcmeClient.xml",
      "node": "accounts.account",
      "base": "acmeclient/accounts",
      "key": "account",
      "actions": {"add": "add", "get": "get", "set": "update", "del": "del", "search": "search"},
      "reconfigure": "acmeclient/service/reconfigure",
      "name_field": "name",
      "zero_field": "name",
      "fields": {
        "id": {"skip": true},
        "key": {"skip": true},
        "ca": {"go_name": "CA", "description": "Certificate authority."},
        "custom_ca": {"go_name": "CustomCA", "description": "ACME directory URL, for ca = custom."},
        "eab_kid": {"go_name": "EABKID", "description": "External Account Binding key id (ZeroSSL, Google, ...)."},
        "eab_hmac": {"go_name": "EABHMAC", "sensitive": true, "description": "External Account Binding HMAC key."},
        "statusCode": {"attr": "status_code", "computed": true, "tf_unstable": true, "description": "Last ACME status: 100 pending, 200 OK, 250 revoked/deactivated, 300 configuration error, 400 validation or registration failed, 500 internal error."},
        "statusLastUpdate": {"computed": true, "tf": false}
      },
      "example": {"name": "letsencrypt", "email": "me@example.com"}
    },
    {
      "resource": "acme_certificate",
      "go_name": "AcmeCertificate",
      "plural": "Certificates",
      "description": "An ACME certificate (Services → ACME Client → Certificates). Terraform manages the configuration; OPNsense issues and renews the certificate itself (or use the MCP tool acme_certificate_issue / the web UI to issue it immediately).",
      "model": "plugins/security/acme-client/AcmeClient/AcmeClient.xml",
      "node": "certificates.certificate",
      "base": "acmeclient/certificates",
      "key": "certificate",
      "actions": {"add": "add", "get": "get", "set": "update", "del": "del", "search": "search"},
      "reconfigure": "acmeclient/service/reconfigure",
      "name_field": "name",
      "zero_field": "name",
      "no_test": true,
      "fields": {
        "id": {"skip": true},
        "name": {"description": "Common name, e.g. `fw.example.com`."},
        "altNames": {"attr": "alt_names", "tf_type": "set", "description": "Additional names (SANs), in lower case.",
                     "validators": ["setvalidator.ValueStringsAre(stringvalidator.RegexMatches(lowerCaseRe, \"must be lower case without spaces\"))"]},
        "account": {"attr": "account_id", "go_name": "Account", "description": "ID of an opnsense_acme_account.",
                    "validators": ["stringvalidator.RegexMatches(uuidRe, \"must be a UUID\")"]},
        "validationMethod": {"attr": "challenge_type_id", "go_name": "ValidationMethod", "description": "ID of an opnsense_acme_challenge_type.",
                             "validators": ["stringvalidator.RegexMatches(uuidRe, \"must be a UUID\")"]},
        "keyLength": {"attr": "key_length"},
        "ocsp": {"go_name": "OCSP", "description": "Request OCSP must-staple."},
        "profile": {"description": "ACME profile to request, if the CA offers several."},
        "restartActions": {"attr": "automation_ids", "go_name": "RestartActions", "description": "IDs of opnsense_acme_automation resources to run after issue/renewal."},
        "autoRenewal": {"attr": "auto_renewal"},
        "renewInterval": {"attr": "renew_interval", "description": "Days between renewals."},
        "aliasmode": {"attr": "alias_mode", "go_name": "AliasMode", "description": "DNS alias mode for DNS-01."},
        "domainalias": {"attr": "domain_alias", "go_name": "DomainAlias", "description": "Domain alias, for alias_mode domain."},
        "challengealias": {"attr": "challenge_alias", "go_name": "ChallengeAlias", "description": "Challenge alias, for alias_mode challenge."},
        "certRefId": {"attr": "cert_ref_id", "go_name": "CertRefID", "computed": true, "tf_unstable": true, "description": "refid of the issued certificate in System → Trust → Certificates."},
        "lastUpdate": {"attr": "last_update", "computed": true, "tf_unstable": true, "description": "Unix time of the last successful issue or renewal."},
        "statusCode": {"attr": "status_code", "computed": true, "tf_unstable": true, "description": "Last ACME status: 100 pending, 200 OK, 250 revoked/deactivated, 300 configuration error, 400 validation or registration failed, 500 internal error."},
        "statusLastUpdate": {"computed": true, "tf": false}
      }
    }
  ]
}
