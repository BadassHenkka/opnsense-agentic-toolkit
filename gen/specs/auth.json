{
  "area": "auth",
  "title": "System → Access: users, groups and API keys",
  "items": [
    {
      "resource": "auth_group",
      "go_name": "Group",
      "description": "A local group (System → Access → Groups). Privileges granted to the group apply to its members; membership is managed on `opnsense_auth_user.groups`.",
      "model": "core/Auth/Group.xml",
      "node": "group",
      "base": "auth/group",
      "key": "group",
      "suffix": "",
      "actions": {
        "add": "add",
        "get": "get",
        "set": "set",
        "del": "del",
        "search": "search"
      },
      "name_field": "name",
      "zero_field": "name",
      "fields": {
        "gid": {
          "computed": true,
          "description": "Numeric group id OPNsense assigns; use it in `opnsense_auth_user.groups`.",
          "type": "string"
        },
        "scope": {
          "computed": true,
          "description": "`system` for built-in groups, `user` otherwise."
        },
        "priv": {
          "attr": "privileges",
          "go_name": "Privileges",
          "type": "refs",
          "description": "Privileges, e.g. `page-all` or `api-firewall-alias` (System → Access → Privileges)."
        },
        "member": {
          "go_name": "Members",
          "type": "refs",
          "computed": true,
          "description": "uids of the members (read-only).",
          "tf": false
        },
        "source_networks": {
          "description": "Networks members may log in from; empty for any."
        }
      },
      "example": {
        "name": "automation",
        "description": "API automation",
        "priv": "page-all"
      },
      "update": {
        "description": "API automation accounts"
      }
    },
    {
      "resource": "auth_user",
      "go_name": "User",
      "description": "A local user (System → Access → Users). For automation accounts leave the password empty and add an `opnsense_auth_api_key`.",
      "model": "core/Auth/User.xml",
      "node": "user",
      "base": "auth/user",
      "key": "user",
      "suffix": "",
      "actions": {
        "add": "add",
        "get": "get",
        "set": "set",
        "del": "del",
        "search": "search"
      },
      "name_field": "name",
      "zero_field": "name",
      "fields": {
        "uid": {
          "computed": true,
          "description": "Numeric user id OPNsense assigns.",
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Login name."
        },
        "disabled": {
          "attr": "enabled",
          "go_name": "Disabled",
          "invert": true
        },
        "scope": {
          "computed": true,
          "description": "`system` for built-in users, `user` otherwise."
        },
        "expires": {
          "type": "string",
          "description": "Expiry date `MM/DD/YYYY`; empty for never."
        },
        "authorizedkeys": {
          "attr": "authorized_keys",
          "go_name": "AuthorizedKeys",
          "type": "string",
          "description": "SSH public keys, one per line."
        },
        "otp_seed": {
          "skip": true
        },
        "shell": {
          "type": "ref",
          "description": "Login shell, e.g. `/bin/sh`; empty for none."
        },
        "password": {
          "description": "Password; write-only (OPNsense stores a hash). Leave empty for API-only accounts."
        },
        "pwd_changed_at": {
          "computed": true,
          "tf": false
        },
        "landing_page": {
          "description": "Page shown after login, e.g. `/ui/core/dashboard`."
        },
        "comment": {},
        "email": {},
        "descr": {
          "attr": "full_name",
          "go_name": "FullName",
          "description": "Full name."
        },
        "apikeys": {
          "skip": true
        },
        "priv": {
          "attr": "privileges",
          "go_name": "Privileges",
          "type": "refs",
          "description": "Privileges granted directly to the user, e.g. `page-all`."
        },
        "language": {
          "type": "ref",
          "description": "GUI language; empty for the system default."
        },
        "group_memberships": {
          "attr": "groups",
          "go_name": "Groups",
          "type": "refs",
          "include": true,
          "description": "gids of the groups the user belongs to (`opnsense_auth_group.x.gid`)."
        },
        "dashboard": {
          "skip": true
        },
        "menu_favorites": {
          "skip": true
        }
      },
      "example": {
        "name": "terraform",
        "descr": "Terraform",
        "group_memberships": "1999"
      },
      "update": {
        "comment": "managed by Terraform"
      }
    }
  ]
}
