          "type": "list",
          "tf_type": "set"
        },
        "option_data.routers": {
          "attr": "routers",
          "type": "list",
          "tf_type": "set"
        },
        "option_data.static_routes": {
          "attr": "static_routes",
          "type": "string"
        },
        "option_data.classless_static_route": {
          "attr": "classless_static_route",
          "type": "string"
        },
        "option_data.domain_name": {
          "attr": "domain_name"
        },
        "option_data.ntp_servers": {
          "attr": "ntp_servers",
          "type": "list",
          "tf_type": "set"
        },
        "option_data.time_servers": {
          "attr": "time_servers",
          "type": "list",
          "tf_type": "set"
        },
        "option_data.tftp_server_name": {
          "attr": "tftp_server_name"
        },
        "option_data.boot_file_name": {
          "attr": "boot_file_name"
        },
        "option_data.v6_only_preferred": {
          "attr": "v6_only_preferred",
          "type": "int"
