    {
      "resource": "kea_dhcp4_option",
      "go_name": "KeaDhcp4Option",
      "plural": "Dhcp4Options",
      "description": "A custom DHCP4 option that can be attached to subnets and reservations (Services \u2192 Kea DHCP \u2192 Kea DHCPv4 \u2192 Settings \u2192 Options).",
