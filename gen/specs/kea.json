          "description": "Forward DNS zone to update."
        },
        "ddns_reverse_zone": {
          "description": "Reverse DNS zone to update."
        },
        "ddns_qualifying_suffix": {
          "description": "Suffix appended to host names for DDNS."
        },
        "ddns_dns_server": {
          "description": "DNS server that receives the updates."
        },
        "ddns_dns_port": {
          "type": "int"
        },
        "ddns_domain_key_name": {
          "description": "TSIG key name."
        },
        "ddns_domain_key_secret": {
          "type": "string",
          "sensitive": true,
          "description": "TSIG key secret (base64)."
        },
        "ddns_domain_key_algorithm": {
          "description": "hmac-md5 ... hmac-sha512."
        },
        "ddns_override_no_update": {},
        "ddns_override_client_update": {},
        "ddns_update_on_renew": {},
        "ddns_conflict_resolution_mode": {
          "description": "Empty for check-with-dhcid."
        }
