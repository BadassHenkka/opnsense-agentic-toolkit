      "reconfigure": "kea/service/reconfigure",
      "fields": {
        "code": {
          "type": "ref",
          "description": "Option code (see the web UI list)."
        },
        "encoding": {
          "description": "How data is encoded: hex, ipv4-address, ipv6-address, uint8, uint16, uint32, int32, boolean, string, fqdn."
        },
        "data": {
          "type": "string",
          "description": "Option value in the chosen encoding."
        },
        "force": {
          "description": "Send the option even if the client did not ask for it."
        },
        "match_code": {
          "type": "ref",
          "description": "Only for clients sending this option code."
        },
        "match_encoding": {},
        "match_data": {
          "type": "string"
