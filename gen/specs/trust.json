      "resource": "trust_settings",
      "go_name": "TrustSettings",
      "plural": "Settings",
      "description": "Trust settings (System → Trust → Settings): CRL handling and the system-wide OpenSSL policy.",
      "model": "core/Trust/General.xml",
      "node": "",
      "path": [
        "trust"
      ],
      "get": "trust/settings/get",
      "set": "trust/settings/set",
