{
  "area": "trust",
  "title": "System → Trust: authorities, certificates and settings",
  "items": [
    {
      "resource": "trust_ca",
      "go_name": "TrustCA",
      "plural": "CAs",
      "description": "A certificate authority (System → Trust → Authorities). Changing anything but `description` creates a new CA; OPNsense refuses to delete one that is in use.",
      "model": "core/Trust/Ca.xml",
      "node": "ca",
      "base": "trust/ca",
      "key": "ca",
      "suffix": "",
      "actions": {
        "add": "add",
        "get": "get",
        "set": "set",
        "del": "del",
        "search": "search"
      },
      "name_field": "descr",
      "zero_field": "refid",
      "hooks": [
        "to_api"
      ],
      "fields": {
        "descr": {
          "attr": "description",
          "go_name": "Description",
          "description": "Name shown in OPNsense; the only attribute that can change in place."
        },
        "refid": {
          "computed": true,
          "fake_value": "%d00000000000a",
          "description": "Reference id other OPNsense settings use for this item (e.g. `ssl-certref`)."
        },
        "crt": {
          "skip": true
        },
        "prv": {
          "skip": true
        },
        "crt_payload": {
          "attr": "certificate",
          "go_name": "Certificate",
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "stringplanmodifier.UseStateForUnknown()",
            "replaceOnChangeString()"
          ],
          "description": "Certificate (PEM). Set it when importing; generated otherwise.",
          "no_default": true
        },
        "prv_payload": {
          "attr": "private_key",
          "go_name": "PrivateKey",
          "write_only": true,
          "include": true,
          "sensitive": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "Private key (PEM) to import. A key OPNsense generates is never stored in Terraform state.",
          "no_default": true
        },
        "valid_from": {
          "include": true,
          "computed": true,
          "description": "Start of validity (unix time)."
        },
        "valid_to": {
          "include": true,
          "computed": true,
          "description": "End of validity (unix time)."
        },
        "name": {
          "skip": true
        },
        "commonname": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "Common name (CN).",
          "attr": "common_name",
          "go_name": "CommonName"
        },
        "country": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "Country code, e.g. `FI`."
        },
        "state": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "State or province."
        },
        "city": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "City."
        },
        "organization": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "Organization (O)."
        },
        "organizationalunit": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "Organizational unit (OU).",
          "attr": "organizational_unit",
          "go_name": "OrganizationalUnit"
        },
        "email": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "E-mail address in the subject."
        },
        "key_type": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "Key type: RSA bits (`2048`, `4096`, ...) or an EC curve (`prime256v1`, `secp384r1`, ...)."
        },
        "digest": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "Digest algorithm."
        },
        "lifetime": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeInt64()"
          ],
          "description": "Lifetime in days."
        },
        "ocsp_uri": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "OCSP URI added to the authorityInfoAccess extension.",
          "type": "string"
        },
        "serial": {
          "skip": true
        },
        "refcount": {
          "skip": true
        },
        "caref": {
          "write_only": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "refid of the CA that signs this one (an intermediate); empty for a self-signed root.",
          "attr": "issuer_refid",
          "go_name": "IssuerRef",
          "type": "ref"
        },
        "action": {
          "write_only": true,
          "include": true,
          "plan_modifiers": [
            "replaceOnChangeString()"
          ],
          "description": "`internal` creates a CA, `existing` imports `certificate` (and `private_key`), `ocsp` creates an OCSP signing certificate.",
          "attr": "method",
          "go_name": "Action"
        }
      },
      "example": {
        "descr": "Home CA",
        "commonname": "Home CA",
        "country": "FI"
      },
      "update": {
        "descr": "Home root CA"
      },
      "no_test": true
    },
