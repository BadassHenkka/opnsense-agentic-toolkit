# State in an S3-compatible bucket (MinIO on TrueNAS, Garage, Ceph, AWS S3, ...).
# Copy to backend.tf, adjust, then `terraform init`.
# Credentials are never written here: export AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
terraform {
  backend "s3" {
    bucket = "tfstate"
    key    = "opnsense/terraform.tfstate"
    region = "us-east-1" # any value; self-hosted S3 ignores it

    endpoints      = { s3 = "https://minio.home.lan:9000" }
    use_path_style = true
    use_lockfile   = true # native S3 locking (Terraform 1.10+), no DynamoDB needed

    # Needed for non-AWS S3 implementations.
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    # skip_s3_checksum = true   # only if an older MinIO rejects uploads

    encrypt = true
  }
}
