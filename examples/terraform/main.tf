terraform {
  required_providers {
    opnsense = {
      source = "registry.terraform.io/smulis/opnsense"
    }
  }
}

# Credentials come from OPNSENSE_URL, OPNSENSE_API_KEY, OPNSENSE_API_SECRET.
provider "opnsense" {}

resource "opnsense_firewall_alias" "homelab_servers" {
  name        = "homelab_servers"
  type        = "host"
  content     = ["10.0.10.5", "10.0.10.6"]
  description = "Proxmox and TrueNAS"
}

resource "opnsense_firewall_alias" "web_ports" {
  name    = "web_ports"
  type    = "port"
  content = ["80", "443"]
}

resource "opnsense_unbound_host_override" "nas" {
  hostname    = "nas"
  domain      = "home.lan"
  server      = "10.0.10.6"
  description = "TrueNAS"
}

resource "opnsense_unbound_host_override" "nas_v6" {
  hostname = "nas"
  domain   = "home.lan"
  type     = "AAAA"
  server   = "fd00::6"
}

resource "opnsense_unbound_host_alias" "truenas" {
  host_override_id = opnsense_unbound_host_override.nas.id
  hostname         = "truenas"
  domain           = "home.lan"
}

resource "opnsense_unbound_host_override" "mail" {
  domain      = "home.lan"
  type        = "MX"
  mx          = "mail.home.lan"
  mx_priority = 10
}

# --- ACME: a Let's Encrypt certificate for the firewall via Cloudflare DNS-01 ---

variable "cloudflare_api_token" {
  type      = string
  sensitive = true
}

resource "opnsense_acme_settings" "this" {
  enabled = true
}

resource "opnsense_acme_account" "letsencrypt" {
  name  = "letsencrypt"
  email = "admin@example.com"
  ca    = "letsencrypt" # letsencrypt_test while experimenting
}

resource "opnsense_acme_challenge_type" "cloudflare" {
  name        = "cloudflare"
  method      = "dns01"
  dns_service = "dns_cf"
  params = {
    dns_cf_token = var.cloudflare_api_token
  }
}

resource "opnsense_acme_automation" "restart_gui" {
  name = "restart-web-ui"
  type = "configd_restart_gui"
}

resource "opnsense_acme_certificate" "firewall" {
  name              = "fw.example.com"
  alt_names         = ["vpn.example.com"]
  account_id        = opnsense_acme_account.letsencrypt.id
  challenge_type_id = opnsense_acme_challenge_type.cloudflare.id
  automation_ids    = [opnsense_acme_automation.restart_gui.id]
  key_length        = "key_ec256"
}

# --- WireGuard road-warrior VPN ---

variable "phone_public_key" {
  type        = string
  description = "Public key from the WireGuard app on the phone"
}

resource "opnsense_wireguard_settings" "this" {
  enabled = true
}

resource "opnsense_wireguard_instance" "roadwarrior" {
  name             = "roadwarrior"
  listen_port      = 51820
  tunnel_addresses = ["10.10.10.1/24"]
  dns              = ["10.10.10.1"]
  # private_key omitted: generated by the provider
}

resource "opnsense_wireguard_peer" "phone" {
  name             = "phone"
  public_key       = var.phone_public_key
  tunnel_addresses = ["10.10.10.2/32"]
  instance_ids     = [opnsense_wireguard_instance.roadwarrior.id]
}

# --- WireGuard site-to-site: reach 192.168.50.0/24 behind a remote router ---
#
# Prerequisite (manual, once): Interfaces → Assignments → assign wg1 (this instance), enable it.
# It becomes e.g. "opt3". Then add firewall rules on that interface.

variable "site2_public_key" {
  type = string
}

resource "opnsense_wireguard_instance" "site2" {
  name             = "site2"
  listen_port      = 51821
  tunnel_addresses = ["10.20.0.1/30"]
  disable_routes   = true # routing is done with the gateway + static route below
}

resource "opnsense_wireguard_peer" "site2_router" {
  name             = "site2-router"
  public_key       = var.site2_public_key
  endpoint_host    = "site2.example.com"
  endpoint_port    = 51820
  keepalive        = 25
  tunnel_addresses = ["10.20.0.2/32", "192.168.50.0/24"] # the peer itself + the LAN behind it
  instance_ids     = [opnsense_wireguard_instance.site2.id]
}

resource "opnsense_gateway" "site2" {
  name        = "WG_SITE2"
  interface   = "opt3"     # the assigned name of wg1
  address     = "10.20.0.2" # the remote peer's tunnel address
  far_gateway = true
  monitoring  = true        # dpinger shows loss/latency of the tunnel
}

resource "opnsense_route" "site2_lan" {
  network     = "192.168.50.0/24"
  gateway     = opnsense_gateway.site2.name
  description = "Site 2 LAN via WireGuard"
}

# Allow site 2 to reach the NAS over SMB, and nothing else on the LAN.
resource "opnsense_firewall_rule" "site2_to_nas" {
  description      = "site2 to NAS (SMB)"
  sequence         = 100
  interfaces       = ["opt3"]
  protocol         = "TCP"
  source           = ["192.168.50.0/24"]
  destination      = ["192.168.1.10"]
  destination_port = "445"
}

resource "opnsense_firewall_rule" "site2_block_lan" {
  description = "site2 block rest of LAN"
  sequence    = 200
  interfaces  = ["opt3"]
  action      = "block"
  destination = ["lan"]
  log         = true
}

# --- Wake on LAN: wake the NAS with `terraform apply -invoke=action.opnsense_wol_wake.nas` ---

resource "opnsense_plugin" "wol" {
  name = "os-wol"
}

resource "opnsense_wol_host" "nas" {
  interface   = "lan"
  mac         = "00:11:22:33:44:55"
  description = "nas"
  depends_on  = [opnsense_plugin.wol]
}

action "opnsense_wol_wake" "nas" {
  config {
    host_id = opnsense_wol_host.nas.id
  }
}

# --- Caddy: https://grafana.lab.example.com -> 192.168.1.30:3000 ---

resource "opnsense_plugin" "caddy" {
  name = "os-caddy"
}

resource "opnsense_caddy_settings" "this" {
  acme_email = "me@example.com"
  depends_on = [opnsense_plugin.caddy]
}

resource "opnsense_caddy_access_list" "lan" {
  name       = "lan-only"
  client_ips = ["192.168.1.0/24"]
}

resource "opnsense_caddy_domain" "grafana" {
  domain         = "grafana.lab.example.com"
  access_list_id = opnsense_caddy_access_list.lan.id
  depends_on     = [opnsense_caddy_settings.this]
}

resource "opnsense_caddy_handler" "grafana" {
  domain_id     = opnsense_caddy_domain.grafana.id
  upstreams     = ["192.168.1.30"]
  upstream_port = 3000
  description   = "grafana"
}

# --- Generated resources: an IoT VLAN, remote logging and a nightly job ---

resource "opnsense_vlan" "iot" {
  parent      = "igb1"
  tag         = 30
  description = "IoT"
}

resource "opnsense_syslog_destination" "loki" {
  hostname    = "logs.lab.example.com"
  transport   = "udp4"
  port        = "514"
  level       = ["info", "notice", "warn", "err"]
  description = "loki"
}

resource "opnsense_cron_job" "changelog" {
  command     = "firmware changelog cron"
  minutes     = "0"
  hours       = "3"
  description = "fetch changelog nightly"
}

output "iot_vlan_device" {
  value = opnsense_vlan.iot.device # assign this device (Interfaces → Assignments)
}

output "wireguard_public_key" {
  value = opnsense_wireguard_instance.roadwarrior.public_key
}

output "homelab_servers_id" {
  value = opnsense_firewall_alias.homelab_servers.id
}

# --- Prometheus: node_exporter on the firewall, scraped from the monitoring host ---

resource "opnsense_plugin" "node_exporter" {
  name = "os-node_exporter"
}

resource "opnsense_node_exporter_settings" "this" {
  enabled        = true
  listen_address = "192.168.1.1"
  listen_port    = 9100
  cpu            = true
  filesystem     = true
  loadavg        = true
  meminfo        = true
  netdev         = true
  depends_on     = [opnsense_plugin.node_exporter]
}

resource "opnsense_firewall_rule" "prometheus_scrape" {
  description      = "Prometheus scrape node_exporter"
  sequence         = 300
  interfaces       = ["lan"]
  protocol         = "TCP"
  source           = ["192.168.1.20"]
  destination      = ["192.168.1.1"]
  destination_port = "9100"
}
